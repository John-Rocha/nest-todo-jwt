@baseUrl = http://localhost:3000/api

POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "name": "John Rocha",
  "email": "john@email.com",
  "password": "123456"
}

###

# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "john@email.com",
  "password": "123456"
}

###

GET {{baseUrl}}/auth/me
Authorization: Bearer {{login.response.body.$.accessToken}}

###

# @name createTodo
POST {{baseUrl}}/todos
Content-Type: application/json
Authorization: Bearer {{login.response.body.$.accessToken}}

{
  "title": "Estudar Flutter",
  "description": "Estudar o framework Flutter para desenvolvimento de aplicativos móveis."
}

###

GET {{baseUrl}}/todos
Authorization: Bearer {{login.response.body.$.accessToken}}

###

GET {{baseUrl}}/todos/{{createTodo.response.body.$.todo.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}